(program erweiterungen
  (type tfeld (array ((.. 1 5)) integer))
  (type tpunkt (record (field (x y) integer)))
  (const werte tfeld (list 3 (- 1) 4 (- 1) 5))
  (var (ziffern) (set-of (.. 0 9)))
  (var (z) integer)
  (var (ch) char)
  (function summe
    (params (const (f) tfeld))
    (result integer)
    (var (x) integer)
    (begin
      (:= result 0)
      (for-in x f (begin (if (< x 0) (call continue)) (:= result (+ result x))))))
  (function ersternegativer
    (params (const (f) tfeld))
    (result integer)
    (var (i) integer)
    (begin
      (:= ersternegativer 0)
      (for i
        (call low f)
        to
        (call high f)
        (if (< (index f i) 0) (begin (:= result i) (call break))))))
  (procedure zeige
    (params (const (p) tpunkt) (const (titel) string))
    (begin (call writeln titel ": " (. p x) "," (. p y))))
  (begin
    (call writeln (call summe werte) " " (call ersternegativer werte))
    (for-in ch "abc" (call write (call upcase ch)))
    (call writeln)
    (:= ziffern (set 1 3 5))
    (for-in z ziffern (call write z))
    (call writeln)
    (while true (begin (:= z (+ z 1)) (if (> z 10) (call break))))
    (repeat (call dec z) (if (call odd z) (call continue)) (until (= z 0)))))
