(program qualifiziert
  (uses crt dos)
  (type tfarbe system.byte)
  (var (std min sek hs) word)
  (var (writeln) integer)
  (begin
    (call (. system writeln) "qualifiziert")
    (call (. crt textcolor) (. crt red))
    (call (. dos gettime) std min sek hs)
    (:= writeln 3)
    (call (. system writeln) writeln " " (fmt std 2) ":" (fmt min 2))))
