(program ausdruecke
  (var (a b c) integer)
  (var (x y) real)
  (var (p q) boolean)
  (var (w) word)
  (var (s) (set-of char))
  (begin
    (:= a 7)
    (:= b 3)
    (:= c (- (+ a (* b 2)) (mod (div a b) 2)))
    (:= c (* (- a) (- b)))
    (:= c (* (+ a b) (- a b)))
    (:= c (xor (or (shl a 2) (and (shr b 1) $0F)) 255))
    (:= x (- (+ (/ a b) 1.0E2) 3.5e-1))
    (:= y (- x))
    (:= p (or (not (> a b)) (and (>= b c) (<> a c))))
    (:= q (= (= a b) p))
    (:= p (not (not q)))
    (:= w (+ (+ (call word a) (call ord "A")) (call ord p)))
    (:= s (set (.. "a" "z") (.. "A" "Z") "_"))
    (:= q (in "x" s))
    (:= p (xor (in c (set (.. 1 10))) q))
    (:= x (+ x))
    (:= a
      (+ (+ (+ (call trunc x) (call round y)) (call abs (- 3))) (call sqr 2)))))
