(program zeichenketten
  (const crlf "\r\n")
  (const glocke "\a")
  (const gruss "Grüß Gott")
  (var (s t) string)
  (var (kurz) (string 5))
  (var (i p) integer)
  (begin
    (:= s (+ (+ "Turbo" " ") "Pascal"))
    (:= kurz s)
    (call writeln kurz " / " (call length s) " / " (call ord (index s 0)))
    (:= t (call copy s 7 6))
    (:= p (call pos "Pascal" s))
    (call delete s 1 6)
    (call insert "Borland " s 1)
    (:= s (call concat s "!" crlf))
    (for i 1 to (call length t) (:= (index t i) (call upcase (index t i))))
    (call writeln t p)
    (call writeln "Er sagte: 'Hallo'" glocke)
    (call writeln gruss " hat " (call length gruss) " Bytes")
    (call str (fmt 3.14159 6 2) s)
    (call val "123" i p)
    (call writeln "Zeile 1\r\nZeile 2" "\r\nZeile 3")))
