(program typisiertekonstanten
  (type tpunkt (record (field (x y) integer)))
  (type tfarbe (enum rot gruen blau))
  (type tmatrix (array ((.. 1 2) (.. 1 3)) real))
  (type tlinie (record (field (von bis) tpunkt) (field (farbe) tfarbe)))
  (const max integer 100)
  (const name (string 10) "WasmPascal")
  (const ursprung tpunkt (record-const (x 0) (y 0)))
  (const einheit tmatrix (list (list 1.0 0.0 0.0) (list 0.0 1.0 0.0)))
  (const linie tlinie
    (record-const
      (von (record-const (x 1) (y 2)))
      (bis (record-const (x 3) (y 4)))
      (farbe blau)))
  (const primzahlen (set-of byte) (set 2 3 5 7 11))
  (const tage
    (array ((.. 1 12)) byte)
    (list 31 28 31 30 31 30 31 31 30 31 30 31))
  (const nichts (^ integer) nil)
  (const faktor real (* (+ 1 2) 0.5))
  (const zeichen (array ((.. 0 2)) char) (list "a" "b" "c"))
  (const grenze (div (call sizeof tmatrix) 2))
  (begin
    (call writeln name " "
      (. ursprung x)
      " "
      (fmt (index einheit 2 2) 0 1)
      " "
      (index tage 2))
    (if (in 7 primzahlen) (call writeln (call ord (. linie farbe))))))
