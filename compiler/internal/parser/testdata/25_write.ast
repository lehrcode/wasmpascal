(program formatierung
  (var (r) real)
  (var (i) integer)
  (var (b) boolean)
  (var (f) text)
  (begin
    (:= r 1.5)
    (:= i (- 42))
    (:= b true)
    (call writeln r)
    (call writeln (fmt r 8 2) (fmt i 6) (fmt b 7))
    (call writeln "|" (fmt "links" (- 10)) "|")
    (call write "ohne Zeilenende")
    (call writeln)
    (call write output "Ausgabe " i)
    (call writeln output)
    (call assign f "")
    (call rewrite f)
    (call writeln f (fmt r 0 3) " " (fmt 2.5E-3 12) " " (fmt (* i 2) 4))
    (call close f)))
