(program zeiger
  (type t integer)
  (type p (^ t))
  (type pp (^ p))
  (type pstr (^ string))
  (type prec (^ trec))
  (type trec (record (field (wert) t) (field (next) prec)))
  (var (a) t)
  (var (p1) p)
  (var (pp1) pp)
  (var (ps) pstr)
  (var (r) prec)
  (var (roh) pointer)
  (begin
    (:= a 5)
    (:= p1 (@ a))
    (:= pp1 (@ p1))
    (:= (^ (^ pp1)) 7)
    (call writeln a " " (^ p1))
    (call new ps)
    (:= (^ ps) "Zeiger auf String")
    (call writeln (^ ps) " " (call length (^ ps)))
    (call dispose ps)
    (call new r)
    (:= (. (^ r) next) nil)
    (:= (. (^ r) wert) (+ (^ (^ pp1)) 1))
    (:= roh r)
    (if
      (= (. (^ (call prec roh)) next) nil)
      (call writeln (. (^ (call prec roh)) wert)))
    (call getmem roh 100)
    (call freemem roh 100)
    (:= p1 (call ptr 0 (call ofs a)))
    (call writeln (call seg a) (= (call addr a) (@ a)))))
