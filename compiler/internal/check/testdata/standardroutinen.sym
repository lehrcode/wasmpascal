type PRec = ^TRec (size 4, align 4)
type TRec = record (size 8, align 4)
  a: Integer @0
  b: Integer @4
var i: Integer (size 4)
var code: Integer (size 4)
var w: Word (size 4)
var l: LongInt (size 4)
var r: Real (size 8)
var c: Char (size 1)
var b: Boolean (size 1)
var s: string (size 256)
var t: Text (size 304)
var f: file of TRec (size 48)
var u: file (size 48)
var p: PRec (size 4)
var q: Pointer (size 4)
var rec: TRec (size 8)
var buf: array[1..128] of Byte (size 128)
